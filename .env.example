# Copy to .env and fill in. Never commit .env.

# Get a key at https://ebird.org/api/keygen
# Recommended: leave this out and export it from your shell profile instead
# (add `export EBIRD_API_KEY=...` to ~/.zshrc). A value in your shell wins over this file.
# EBIRD_API_KEY=your-ebird-api-key

# eBird region code for your county, e.g. US-WA-033 (King County, WA).
# Find yours with: curl -H "X-eBirdApiToken: $EBIRD_API_KEY" https://api.ebird.org/v2/ref/region/list/subnational2/US-WA
REGION_CODE=US-WA-033

# Local timezone, used for "today" and for the schedule
TZ=America/Los_Angeles

# Local hour (0-23) of the one daily eBird pull. If it's missed, it runs at the next chance.
SCHEDULE_HOUR=6

# Docker Compose overrides this to point at the db service
DATABASE_URL=sqlite:///./fieldodds.db

# Postgres credentials used by docker-compose
POSTGRES_USER=fieldodds
POSTGRES_PASSWORD=fieldodds
POSTGRES_DB=fieldodds

# Allow POST /api/pipeline/run/{job}. Keep false anywhere public.
ENABLE_MANUAL_TRIGGERS=true
